{
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-inline'; connect-src 'self' https://pkhftlbacapcarwnrhzn.supabase.co wss://pkhftlbacapcarwnrhzn.supabase.co https://ipwho.is https://ipapi.co; img-src 'self' data: https:; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "script-src 'self' 'unsafe-inline'; report-uri /csp-report"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/dashboard(/.*)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/login(/.*)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/metasbank-login.html" },
    { "source": "/login/", "destination": "/metasbank-login.html" },
    { "source": "/dashboard", "destination": "/metasbank-member.html" },
    { "source": "/dashboard/", "destination": "/metasbank-member.html" },
    { "source": "/member", "destination": "/metasbank-member.html" },
    { "source": "/member/", "destination": "/metasbank-member.html" },
    { "source": "/admin", "destination": "/metasbank-admin.html" },
    { "source": "/admin/", "destination": "/metasbank-admin.html" },
    { "source": "/agent", "destination": "/metasbank-agent.html" },
    { "source": "/agent/", "destination": "/metasbank-agent.html" },
    { "source": "/signup", "destination": "/metasbank-signup.html" },
    { "source": "/signup/", "destination": "/metasbank-signup.html" },
    { "source": "/admin/login.html", "destination": "/metasbank-admin-login.html" },
    { "source": "/admin-login", "destination": "/metasbank-admin-login.html" },
    { "source": "/admin-login/", "destination": "/metasbank-admin-login.html" },
    { "source": "/deposit-landing", "destination": "/metasbank-deposit-landing.html" },
    { "source": "/deposit-landing/", "destination": "/metasbank-deposit-landing.html" },
    { "source": "/deposit", "destination": "/metasbank-deposit-landing.html" },
    { "source": "/deposit/", "destination": "/metasbank-deposit-landing.html" },
    { "source": "/kyc", "destination": "/metasbank-kyc.html" },
    { "source": "/kyc/", "destination": "/metasbank-kyc.html" },
    { "source": "/policy", "destination": "/policy.html" },
    { "source": "/policy/", "destination": "/policy.html" },
    { "source": "/email-confirmed", "destination": "/email-confirmed.html" },
    { "source": "/email-confirmed/", "destination": "/email-confirmed.html" }
  ]
}
